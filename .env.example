# Copy to .env, then edit locally. Real credentials belong only in .env.
# Existing process environment variables override this file.
APP_ENV=development
LOG_LEVEL=INFO
# Relative to the repository working directory; SQLite only.
DATABASE_URL=sqlite:///./callflow.db
# false keeps nontelephony API operations available without connecting to a PBX.
AMI_ENABLED=true
# Tested lab address only: replace with your VM's actual host-only IPv4 address.
AMI_HOST=192.168.56.101
AMI_PORT=5038
AMI_USERNAME=callflow
# Must match manager.conf. This is a placeholder, not a working password.
AMI_SECRET=replace-with-your-local-secret
# Seconds; timeout must be positive, delay nonnegative.
AMI_TIMEOUT=5
# Total session attempts per application lifespan, including the first connection.
AMI_RECONNECT_ATTEMPTS=5
AMI_RECONNECT_DELAY=2
# Use exactly one API worker. Origination is deliberately disabled.
